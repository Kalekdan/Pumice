<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Select repository · Pumice</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="shell shell--narrow">
      <section class="card">
        <div class="topbar">
          <h1>Select a repository</h1>
          <a href="/vault">Open current vault</a>
        </div>
        <form action="/repos/select" method="post" class="repo-list">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <% repos.forEach((repo) => { %>
            <label class="repo-option">
              <input
                type="radio"
                name="repository"
                value="<%= repo.owner.login %>/<%= repo.name %>"
                <%= selectedRepo && selectedRepo.owner === repo.owner.login && selectedRepo.repo === repo.name ? 'checked' : '' %>
              />
              <span>
                <strong><%= repo.full_name %></strong>
                <small><%= repo.private ? 'Private' : 'Public' %></small>
              </span>
            </label>
          <% }) %>

          <button class="button" type="submit">Use selected repository</button>
        </form>
      </section>
    </main>
  </body>
</html>
