<% if (node.type === "folder") { %>
  <details class="tree-folder" <%= node.open ? 'open' : '' %>>
    <summary><%= node.name %></summary>
    <div class="tree-children">
      <% node.children.forEach((child) => { %>
        <%- include("partials/file-tree-node", { node: child }) %>
      <% }) %>
    </div>
  </details>
<% } else { %>
  <a class="tree-file <%= node.active ? 'active' : '' %>" href="/vault/<%= node.path.split('/').map(encodeURIComponent).join('/') %>">
    <%= node.name.replace(/\.md$/i, "") %>
  </a>
<% } %>
